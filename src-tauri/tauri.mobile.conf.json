{
  "$schema": "https://raw.githubusercontent.com/nicedoc/nicedoc/master/web.json",
  "productName": "JsonMate",
  "version": "1.5.79",
  "identifier": "com.jsonmate.mobile",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "JsonMate",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/mobile/16x16.png",
      "icons/mobile/32x32.png",
      "icons/mobile/128x128.png",
      "icons/mobile/128x128@2x.png",
      "icons/mobile/icon.ico",
      "icons/mobile/icon.png",
      "icons/mobile/16x16.png",
      "icons/mobile/64x64.png",
      "icons/mobile/256x256.png",
      "icons/mobile/512x512.png",
      "icons/mobile/512x512@2x.png"
    ],
    "createUpdaterArtifacts": false,
    "category": "Developer Tools",
    "shortDescription": "JSON 格式化与验证工具",
    "longDescription": "JsonMate 支持 JSON 格式化、压缩、树形视图、内容对比和历史记录。适合移动端 JSON 数据处理。"
  }
}
